# ---- app ----
DATABASE_URL=postgresql+psycopg://choice:choice@localhost:5433/choice
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8001
# ウォレット不要のデモログイン（ローカル確認用。本番では false）
DEV_LOGIN_ENABLED=true
# 運用者のウォレット（カンマ区切り、小文字可）。/ops/jobs（チェーン連携ジョブの一覧と再投入）を使える。空なら DEV_LOGIN_ENABLED のときだけ全員に開放
OPS_ADDRESSES=

# ---- chain (Sepolia) ----
# Sepolia RPC。公開 RPC でも動く（例 https://ethereum-sepolia-rpc.publicnode.com）。空なら ENS 読み取り以外はモック
SEPOLIA_RPC_URL=
# サーバー署名者（ENS 書き込み + Escrow arbiter）。Sepolia ETH を入れておく
# ENSv2 EAC の役割分離: Reputation 鍵は codrea.agent.rating/reviews/completed の setText のみ、Project 鍵は Agent サブレジストリへの register と codrea.project.* の setText のみ
REPUTATION_PRIVATE_KEY=
PROJECT_PRIVATE_KEY=
SERVER_PRIVATE_KEY=
# contracts/ を forge script でデプロイした結果
ESCROW_ADDRESS=
USDC_ADDRESS=

# ---- ENS (ENSv2 Sepolia beta) ----
ENS_PARENT_NAME=guildace.eth
# true にすると Sepolia に実際に subname を発行する
ENS_WRITE_ENABLED=false
# scripts/ens_setup.py の出力
ENS_OWNED_RESOLVER=
ENS_PARENT_SUBREGISTRY=
# scripts/ens_role_resolvers.py の出力（役割ごとの PermissionedResolver）
ENS_REPUTATION_RESOLVER=
ENS_PROJECT_RESOLVER=

# ---- World ID (Developer Portal / World ID 4.0) ----
# Portal でアプリを作り World ID 4.0 を有効化すると app_id / rp_id / signing key が発行される。action の登録は不要（session proof 方式）
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# true にすると Developer Portal（/api/v4/verify）で session proof を検証する
WORLD_VERIFY_ENABLED=false

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- エージェント ----
# 依頼の計画と紛争の論点整理の経路: agents = AG-001 経由（既定）、legacy = 旧 plan_case / summarize_dispute（戻すとき）
AGENT_PIPELINE=agents
# プロンプト本文の版（app/agents/prompts/<PMT-ID>-<版>.txt）
PROMPT_VERSION=v1
# 構造化出力の温度と、エージェント 1 回の実行（その中の LLM 呼び出しも含む）の時間上限（秒）
AGENT_TEMPERATURE=0.2
# トークン予算の基準にするコンテキスト長（各ブロックの上限はこの値の %）
AGENT_CONTEXT_TOKENS=1048576
AGENT_TIME_LIMIT_AG001_S=600
AGENT_TIME_LIMIT_AG002_S=120
AGENT_TIME_LIMIT_AG003_S=180
AGENT_TIME_LIMIT_AG004_S=180
# 上限（反復・タスク数 GRD-003・再確認 GRD-004・トークン数 GRD-005）
AGENT_MAX_ITERATIONS_AG001=30
AGENT_MAX_ITERATIONS_AG002=3
AGENT_MAX_ITERATIONS_AG003=5
AGENT_MAX_ITERATIONS_AG004=5
AGENT_MAX_TASKS_PER_CASE=20
AGENT_MAX_RECONFIRMS_PER_CASE=3
# TOOL-002 が AG-003 に返す候補の件数の上限
AGENT_MAX_CANDIDATES=20
AGENT_COST_TOKENS_PER_CASE=200000
AGENT_COST_TOKENS_PER_DAY=5000000
# 送金のガード: 直近 24 時間の送金額の上限（USDC の最小単位。20,000 USDC）と、送金操作権限の有効日数
FUNDING_LIMIT_24H=20000000000
FUNDING_GRANT_DAYS=30
