# World ID relying-party identifier from the Developer Portal
WORLD_ID_RP_ID=rp_replace_me

# Use production for the real World App.
# Use staging for the World ID simulator.
WORLD_ID_ENVIRONMENT=production

# Local PostgreSQL used to record consumed World ID proofs
POSTGRES_DB=codrea
POSTGRES_USER=codrea
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+psycopg://codrea:replace_with_local_password@127.0.0.1:5432/codrea
