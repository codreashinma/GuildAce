# Public World ID application identifier used by the browser
NEXT_PUBLIC_WORLD_APP_ID=

# World ID v4 relying-party identifier
WORLD_RP_ID=

# Secret key used only by the server to sign RP requests
RP_SIGNING_KEY=


# Python backend URL used only by the Next.js server
WORLD_BACKEND_URL=http://127.0.0.1:8000
